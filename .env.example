# Required: use a long, unique password. Never commit your real .env file.
ADMIN_PASSWORD=replace-this-with-a-long-unique-password
# Required: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=production
# Optional: maximum APK upload size in bytes (default 1 GB)
MAX_APK_SIZE=1073741824
# Optional: keep download logs for this many days (0 means keep forever)
DOWNLOAD_LOG_RETENTION_DAYS=0

# Optional persistent volume paths (recommended on Hostless)
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads
